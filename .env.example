# Castrol video pipeline - environment template.
# Copy to .env and fill. .env is gitignored and must never be committed.
#
# IMPORTANT: this project uses a DEDICATED set of accounts, separate from the
# usual BeHooked ones. GitHub, AWS, Supabase, Vercel and the AI provider are
# all distinct logins. Do not paste credentials from the other projects here.

# ---------------------------------------------------------------- runtime --
ENVIRONMENT=dev              # dev | staging | prod
LOG_LEVEL=INFO

# --------------------------------------------------------------- supabase --
# Project ref is the subdomain of the project URL.
SUPABASE_URL=https://<ref>.supabase.co

# New-style API keys. The legacy JWT keys (anon / service_role) are deprecated
# and are NOT issued to projects created after 01 Nov 2025 - this project has
# never had them, so do not go looking for a service_role key in the dashboard.
#
# Note the two senses of "service_role": the legacy KEY is gone, the Postgres
# ROLE is not. A secret key still authorizes as the service_role Postgres role,
# which still has BYPASSRLS. The RLS comments in the migrations remain accurate.
#
# sb_secret_...  elevated, backend only. Supabase rejects it outright from a
#                browser (User-Agent match -> HTTP 401), which is a real
#                backstop for the classic Next.js server/client boundary slip.
SUPABASE_SECRET_KEY=

# sb_publishable_...  safe to ship to a browser. Only needed if the admin panel
#                     talks to Supabase client-side - e.g. Supabase Auth for
#                     panel login. RLS is deny-all with no policies, so this key
#                     reads no application data by design. Leave blank until
#                     Phase 2 needs it.
SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection. Use the SESSION pooler (port 5432) for the
# worker: transaction pooling (6543) breaks FOR UPDATE ... SKIP LOCKED held
# across statements. If you must use 6543, set statement_cache_size=0.
#
# The pipeline itself (intake/worker/poller/reporter) talks to Postgres
# directly and uses NO API key at all - this URL is the only Supabase
# credential Phase 0 and Phase 1 need. Both keys above stay blank until the
# admin panel exists.
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres

# -------------------------------------------------------------------- aws --
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=                   # private bucket; nothing is public-read
S3_PREFIX=castrol/

# Public delivery host. S3 stays private; the CDN fronts it. Links live 6
# months, enforced by an S3 lifecycle rule at 180 days, not by URL expiry -
# SigV4 presigning caps at 7 days and dies with the instance-role session.
CDN_BASE_URL=https://<cdn-host>

# ------------------------------------------------------ client interface ---
# Inbound: daily export pull.
CLIENT_EXPORT_URL=https://capi.letschbang.com/api/submissions/export/vendor
CLIENT_EXPORT_API_KEY=       # PENDING from client

# Outbound: delivery webhook. Body is {"phone": ..., "videoLink": ...}.
CLIENT_WEBHOOK_URL=https://capi.letschbang.com/api/webhook/video
CLIENT_WEBHOOK_API_KEY=      # sent as the `apikey` header

# The export's created_at_ist has no seconds, no timezone and an ambiguous
# day/month order. This format is PINNED, never inferred. Confirm with the
# client before the first real pull - a misparse silently shifts the window.
EXPORT_TIMESTAMP_FORMAT=%d-%m-%Y %H:%M
EXPORT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------ ai provider --
# apimart gateway. Model ids are pinned per stage so a provider-side default
# change cannot silently alter output.
APIMART_API_KEY=
APIMART_BASE_URL=

TTS_MODEL_ID=
TTS_VOICE_ID=                # fixed male voice, chosen from the 2 client refs
IMAGE_EDIT_MODEL_ID=         # stage B - person replacement
VIDEO_MODEL_ID=              # stage C - avatar / lipsync
LIPSYNC_REPAIR_MODEL_ID=     # stage C2

# ------------------------------------------------------------- pipeline ----
SCRIPT_VERSION=v1
MAX_CONCURRENCY_AUDIO=4
MAX_CONCURRENCY_IMAGE=4
MAX_CONCURRENCY_VIDEO=10
STAGE_MAX_ATTEMPTS=3

# Hard stop. Enforced in Postgres by reserve_vendor_call(); these are the
# values seeded into vendor_limits, kept here for reference only.
# Change caps with SQL, not by editing this file.

# ------------------------------------------------------------- local runs ---
# Stub mode swaps every vendor-calling stage for a deterministic fake, so the
# orchestrator can be driven end-to-end with no provider keys and no spend.
# This is the build-order 1.4 acceptance path. Turn it off at 1.5.
USE_STUB_STAGES=true

# "local" writes artefacts under LOCAL_STORAGE_DIR instead of S3, so the
# pipeline runs without AWS credentials. Use "s3" in staging and prod.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=out/storage

# Version tags that participate in input_hash. Bumping one of these is what
# forces affected jobs to regenerate rather than skip.
NORMALISE_RULES_VERSION=v1
IMAGE_PROMPT_VERSION=v1
CARD_TEMPLATE_VERSION=v1

# Seconds a stage_run may sit in `claimed` before the reaper returns it to the
# queue. Without a reaper a worker OOM parks a job forever.
STAGE_CLAIM_TIMEOUT_S=900
