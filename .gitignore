!.env.local.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# spike + run output (real mechanic photos and generated video land here;
# none of it belongs in git)
spikes/out/
spikes/in/
# same reason as spikes/in: real mechanic faces are dropped here by hand.
# `input/mechanic photo.jpg` was tracked from b2bca86 until 2026-09-09 -
# byte-identical to the gitignored spikes/in/mechanic2.jpg. Untracked now,
# but it is still in history, so treat that photo as disclosed.
input/
out/
tmp/
logs/
*.mp4
*.wav
*.mov

# node (admin panel)
node_modules/
.next/
.vercel/

# os
.DS_Store
Thumbs.db

# keep the spike io dirs on clone
!spikes/in/.gitkeep
!spikes/out/.gitkeep
spikes/out/
