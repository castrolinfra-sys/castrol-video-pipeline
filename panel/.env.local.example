# Panel-only env. Separate from the pipeline's .env - this app never talks to
# S3, the vendors, or the client API. It reads Postgres and gates access.

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# sb_publishable_...  browser-safe. Used ONLY for the magic-link session; RLS
# is deny-all with no policies, so this key can read nothing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# sb_secret_...  server-only. Authorizes as service_role and bypasses RLS,
# which is how every query in this app reads anything. Never expose it.
SUPABASE_SECRET_KEY=

# The only access control in the product. Comma-separated.
ADMIN_ALLOWED_EMAILS=you@example.com
