[Unit]
Description=Castrol MAGNATEC video pipeline - one full cycle (container)
Documentation=file:///opt/castrol-video-pipeline/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=castrol
Group=castrol

# The image tag is the ONE thing that changes per deploy, so it lives in a file
# nobody has to edit this unit to change:
#     echo 'CASTROL_IMAGE=gethooked/castrol-video-pipeline:latest' | sudo tee /etc/castrol-image.env
#
# CONTINUOUS DEPLOY, decided 2026-09-15. :latest is moved by CI on every green
# push to main, and `--pull always` below is what makes that real - without it
# `docker run` reuses whatever it cached on the first cycle, so the box freezes
# on an old build while still appearing to track main. That silent freeze is
# worse than either choice made deliberately.
#
# The spend argument against tracking a moving tag is weaker than it looks.
# `_schedule_all()` selects `status NOT IN ('completed','cancelled')`, so a
# changed input_hash NEVER re-renders a finished video - only jobs still open
# when the new image first runs, and the pull lands between cycles rather than
# mid-batch. What you accept instead is that a merge reaches a paying worker
# with no staging and no visual review, and pytest green does not mean a render
# looks right.
#
# To freeze deliberately - a risky merge, a bad batch - pin a sha:
#     echo 'CASTROL_IMAGE=gethooked/castrol-video-pipeline:main-331b386' | sudo tee /etc/castrol-image.env
EnvironmentFile=/etc/castrol-image.env

# The .env is MOUNTED, not passed with --env-file. Docker's --env-file parser is
# not a shell: it does not strip quotes, so KEY="value" arrives as the literal
# "value" with the quotes attached. pydantic-settings reads the same file
# correctly, and the image's WORKDIR is /app, which is where it looks.
#
# A bind mount carries the HOST's numeric ownership through unchanged, and the
# image runs as uid 10001. The .env is 0600, so if the host `castrol` user was
# created with any other uid the container process cannot read one line of it -
# the run dies on missing settings, not on anything that names a permission.
# deploy/README.md therefore pins the host user to `--uid 10001` to match.
#
# `--pull always` needs the pull to be authenticated: the Hub repo is private,
# so `docker login` must have been run AS castrol - systemd reads that user's
# ~/.docker/config.json, not root's.
#
# The pre-clean is for REBOOTS. ExecStopPost below only runs when systemd stops
# the unit; a power-off or a hard stop of the instance skips it, and dockerd does
# not reliably reap a --rm container it never saw exit. The next start then dies
# on "container name castrol-cycle is already in use" - and after a reboot the
# next start is the resume run the timer's OnBootSec exists for.
ExecStartPre=-/usr/bin/docker rm -f castrol-cycle
ExecStart=/usr/bin/docker run --rm \
    --pull always \
    --name castrol-cycle \
    --volume /opt/castrol-video-pipeline/.env:/app/.env:ro \
    --log-driver journald \
    ${CASTROL_IMAGE} \
    cycle

# Leaves nothing behind if the unit is killed rather than exiting.
ExecStopPost=-/usr/bin/docker rm -f castrol-cycle

# Longer than the cycle's own 8h deadline, so the process gets to stop itself.
# See the comment in castrol-cycle.service.
TimeoutStartSec=9h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=castrol-cycle

[Install]
WantedBy=multi-user.target
