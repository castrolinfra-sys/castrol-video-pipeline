#!/bin/sh
# castrol - run any pipeline command on the EC2 worker, in the image the timer uses.
#
# Install once:   sudo install -m 755 castrol /usr/local/bin/castrol
#
#   castrol find 9773128990                  which job is this number?
#   castrol find --status failed             what broke?
#   castrol show 9773128990                  runs, cost, assets
#   castrol events 9773128990                the durable timeline
#   castrol run 9773128990                   drive that ONE job to a finish (SPENDS, asks)
#   castrol --bg run 9773128990 --yes        same, detached - survives the SSM session closing
#
# The rehearsal mounts .env.dryrun instead of .env - the only thing that differs:
#   castrol --dryrun doctor
#   castrol --dryrun --bg cycle --lookback-days 7
# A FLAG, deliberately not an environment variable: `sudo` drops environment
# variables, so `sudo CASTROL_ENV_FILE=... castrol cycle` would have silently
# mounted the REAL .env and turned a rehearsal into a paid run.
#
# Why a wrapper and not `docker exec`: there is no long-running container to exec
# into. The cycle is a oneshot, so between runs nothing is up. Each command is a
# fresh container of the SAME image tag as the timer (/etc/castrol-image.env),
# with the same .env mount, as the same uid - so what you see by hand is what
# the timer sees, not what some other build on the box happens to do.
#
# Logs: every run, foreground or --bg, also goes to journald tagged
# `castrol-manual`, so a command someone ran at 3am is still readable at 9:
#     journalctl -t castrol-manual --since today -o cat
#
# --bg matters for `run`: a render is 8-20 minutes and an SSM session that drops
# kills a foreground process. Killing one loses nothing - the job resumes on the
# next `run` or cycle - but a detached unit just finishes. Follow it with the
# `journalctl -u` line it prints, and stop it with the `systemctl stop` line -
# which works because of the ExecStopPost below, and did NOT before it.
set -eu

IMAGE_ENV=/etc/castrol-image.env
REAL_ENV=/opt/castrol-video-pipeline/.env
DRYRUN_ENV=/opt/castrol-video-pipeline/.env.dryrun
# `always` matches the timer, so a merge to main is what runs here too. Set
# CASTROL_PULL=missing to skip the registry round trip on quick reads.
PULL="${CASTROL_PULL:-always}"

[ -r "$IMAGE_ENV" ] || { echo "castrol: $IMAGE_ENV missing - see deploy/README.md" >&2; exit 78; }
. "$IMAGE_ENV"
: "${CASTROL_IMAGE:?castrol: CASTROL_IMAGE not set in $IMAGE_ENV}"

bg=0
ENV_FILE=$REAL_ENV
tag=castrol-manual
while [ $# -gt 0 ]; do
    case "$1" in
        --bg) bg=1; shift ;;
        --dryrun) ENV_FILE=$DRYRUN_ENV; tag=castrol-dryrun; shift ;;
        *) break ;;
    esac
done

# The pipeline itself refuses a mock run under the real S3 prefix and a real run
# over rehearsal data (dryrun.py). This only chooses which file is mounted.
sudo test -r "$ENV_FILE" || { echo "castrol: $ENV_FILE does not exist" >&2; exit 78; }
if [ "$tag" = castrol-dryrun ]; then
    echo "castrol: DRY RUN - mounting $ENV_FILE" >&2
fi
if [ $# -eq 0 ]; then
    echo "usage: castrol [--dryrun] [--bg] <command> [args]    e.g. castrol find 9773128990" >&2
    exit 64
fi

if [ "$bg" = 1 ]; then
    case " $* " in
        *" run "*|*" redo "*)
            case " $* " in *" --yes "*) ;; *)
                echo "castrol: --bg has no terminal to confirm spend on; add --yes after checking \`castrol show\`" >&2
                exit 64 ;;
            esac ;;
    esac
    unit="$tag-$1-$(date -u +%Y%m%d-%H%M%S)"
    # ExecStopPost is what makes `systemctl stop` actually stop anything.
    #
    # systemd only owns the `docker run` CLIENT. The container belongs to the
    # docker daemon and lives in ITS cgroup, so the default KillMode never
    # reaches it: stop SIGTERMs the client, the client forwards it, the cycle is
    # asleep in its wait loop and does not answer, systemd waits out
    # TimeoutStopSec and SIGKILLs the client - and the container carries on with
    # nothing attached to it. Measured 2026-09-23: `systemctl stop` appeared to
    # hang, and `docker ps` afterwards still showed the cycle up and running.
    #
    # The container is named after the unit precisely so this line can find it.
    # The `-` prefix matters: a container that already exited on its own is not
    # a failure and must not leave the unit in `failed`. 30s is docker's own
    # SIGTERM-then-SIGKILL grace, and TimeoutStopSec is cut to 30 so a stop does
    # not sit through the default 90s first - the container is being killed
    # either way, and killing it loses nothing, because readiness is recomputed
    # from stage_runs on the next run.
    sudo systemd-run --unit="$unit" --uid=castrol --gid=castrol --collect \
        --property=After=docker.service --property=Requires=docker.service \
        --property=TimeoutStopSec=30 \
        --property="ExecStopPost=-/usr/bin/docker stop -t 30 $unit" \
        /usr/bin/docker run --rm --pull "$PULL" --name "$unit" \
            --volume "$ENV_FILE:/app/.env:ro" \
            --log-driver journald --log-opt tag="$tag" \
            "$CASTROL_IMAGE" "$@"
    echo "started $unit"
    echo "  follow:  journalctl -u $unit -f -o cat"
    echo "  status:  systemctl status $unit"
    echo "  stop:    sudo systemctl stop $unit"
    exit 0
fi

tty=""
if [ -t 0 ] && [ -t 1 ]; then tty="-it"; fi
# shellcheck disable=SC2086 # $tty is deliberately unquoted: empty or one flag
exec sudo -u castrol -H /usr/bin/docker run --rm $tty --pull "$PULL" \
    --volume "$ENV_FILE:/app/.env:ro" \
    --log-driver journald --log-opt tag="$tag" \
    "$CASTROL_IMAGE" "$@"
